# Copy this file to .env before running:   cp .env.example .env
# VITE_ vars are baked into the built JS, so these are not secrets.

# Laravel API
VITE_BACKEND_BASE_URL=https://backend.archilance.org

# Socket.IO server (real-time chat + task comments)
VITE_SOCKET_URL=https://socket.archilance.net

VITE_ENV=development
