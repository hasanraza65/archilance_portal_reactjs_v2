# Copy this file to .env before running:   cp .env.example .env
# VITE_ vars are baked into the built JS, so these are not secrets.

# Laravel API
VITE_BACKEND_BASE_URL=https://backend.archilance.org

# Socket.IO relay (real-time chat + task comments).
# Runs on Vercel, so the client MUST use transports: ["websocket"] - see
# src/api/socket.js. Long-polling cannot work on serverless.
VITE_SOCKET_URL=https://socketjs.vercel.app

VITE_ENV=development
